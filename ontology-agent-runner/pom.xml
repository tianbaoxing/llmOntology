<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.conca</groupId>
        <artifactId>ontology-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>ontology-agent-runner</artifactId>
    <name>ontology-agent-runner</name>
    <description>导出智能体独立运行时：shade 平铺依赖 + classpath 内嵌 agent-package.zip，java -jar 即跑</description>

    <dependencies>
        <dependency>
            <groupId>com.conca</groupId>
            <artifactId>ontology-agent-runtime</artifactId>
        </dependency>
        <!-- 独立进程日志绑定（harness 传递 slf4j-api，无容器时需要具体实现） -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.13</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>agent-runner</finalName>
        <plugins>
            <!-- shade 平铺依赖（而非 spring-boot 嵌套 jar）：导出器用普通 zip 重写追加包，
                 STORED 嵌套结构会被破坏导致 loader 失效，平铺无此约束 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <!-- 3.5.x 与 Maven 3.9.6 不兼容：transformer 配置解析报 Cannot find 'resource'（已知回归，3.6.0 修复） -->
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <!-- combine.self="override"：完全覆盖 spring-boot-starter-parent 的 transformers（含
                                 AppendingTransformer 的 <resource> 子元素——按索引合并会把它带进 Manifest transformer 报错）；
                                 runner 无 Spring，Boot 的 spring.handlers 合并器本就不适用 -->
                            <transformers combine.self="override">
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.conca.agentkit.runner.AgentRunnerMain</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- 构建后拷入平台 runtime/ 目录：平台 export-jar 的固化载体 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>copy-runtime-jar</id>
                        <phase>package</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <copy file="${project.build.directory}/agent-runner.jar"
                                      todir="${project.basedir}/../ontology-server/runtime"
                                      overwrite="true"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
