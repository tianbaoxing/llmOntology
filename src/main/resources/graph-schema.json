{
  "version": 1,
  "classes": [
    {
      "name": "Artifact",
      "cnName": "藏品",
      "layer": "instance",
      "keyProp": "item_id",
      "description": "国博馆藏藏品实例，数据源自官网藏品介绍页",
      "properties": [
        {"name": "item_id", "cnName": "藏品编号", "dataType": "STRING", "required": true, "description": "官网藏品唯一标识"},
        {"name": "title", "cnName": "名称", "dataType": "STRING", "required": true, "description": "如：定窑白釉莲纹大碗"},
        {"name": "spec", "cnName": "规格", "dataType": "STRING", "required": false, "description": "尺寸规格，如：高12.5厘米 口径25.6厘米"},
        {"name": "image_url", "cnName": "图片", "dataType": "STRING", "required": false, "description": "官网原图URL"},
        {"name": "detail_url", "cnName": "详情页", "dataType": "STRING", "required": false, "description": "官网介绍页URL"},
        {"name": "era_raw", "cnName": "朝代原文", "dataType": "STRING", "required": false, "description": "官网原始朝代标注"},
        {"name": "category_raw", "cnName": "品类原文", "dataType": "STRING", "required": false, "description": "官网原始品类标注"},
        {"name": "material_raw", "cnName": "质地原文", "dataType": "STRING", "required": false, "description": "官网原始质地标注"}
      ],
      "relations": [
        {"name": "OF_ERA", "cnName": "属于朝代", "toClass": "Era", "description": "藏品断代于某朝代", "example": "MATCH (a:Artifact)-[:OF_ERA]->(e:Era {name:'宋'}) RETURN a.title, a.spec"},
        {"name": "OF_CATEGORY", "cnName": "属于品类", "toClass": "Category", "description": "藏品归入器物品类，如：陶瓷器、玉器", "example": "MATCH (a:Artifact)-[:OF_CATEGORY]->(c:Category) RETURN c.name, count(*) ORDER BY count(*) DESC"},
        {"name": "OF_MATERIAL", "cnName": "材质为", "toClass": "Material", "description": "藏品主要材质，如：瓷、玉、铜", "example": "MATCH (a:Artifact)-[:OF_MATERIAL]->(m:Material {name:'瓷'}) RETURN count(a)"},
        {"name": "HAS_SHAPE", "cnName": "器型为", "toClass": "Shape", "description": "藏品器物形态，如：碗、瓶、炉", "example": "MATCH (a:Artifact)-[:HAS_SHAPE]->(s:Shape {name:'碗'}) RETURN a.title LIMIT 10"},
        {"name": "FROM_KILN", "cnName": "产自窑口", "toClass": "Kiln", "description": "瓷器烧造窑口，如：定窑、景德镇窑", "example": "MATCH (a:Artifact)-[:FROM_KILN]->(k:Kiln) RETURN k.name, count(*) ORDER BY count(*) DESC"},
        {"name": "HAS_DECORATION", "cnName": "纹饰为", "toClass": "Decoration", "description": "藏品表面纹饰，如：莲纹、云龙纹", "example": "MATCH (a:Artifact)-[:HAS_DECORATION]->(d:Decoration {name:'莲纹'}) RETURN a.title LIMIT 10"},
        {"name": "EXCAVATED_AT", "cnName": "出土于", "toClass": "Site", "description": "藏品出土地点", "example": "MATCH (a:Artifact)-[:EXCAVATED_AT]->(s:Site) RETURN s.name, count(*) ORDER BY count(*) DESC"}
      ]
    },
    {
      "name": "Era",
      "cnName": "朝代",
      "layer": "concept",
      "keyProp": "name",
      "description": "历史朝代/时期概念，含主朝代与细分（如：明、明永乐）",
      "properties": [
        {"name": "name", "cnName": "名称", "dataType": "STRING", "required": true, "description": "朝代名，全库唯一"}
      ],
      "relations": [
        {"name": "SUB_ERA_OF", "cnName": "细分于", "toClass": "Era", "description": "细分朝代归属主朝代，如 明永乐→明", "example": "MATCH (sub:Era)-[:SUB_ERA_OF]->(main:Era {name:'明'}) RETURN sub.name"}
      ]
    },
    {
      "name": "Category",
      "cnName": "品类",
      "layer": "concept",
      "keyProp": "name",
      "description": "器物品类概念，如：陶瓷器、玉器、青铜器",
      "properties": [
        {"name": "name", "cnName": "名称", "dataType": "STRING", "required": true, "description": "品类名，全库唯一"}
      ],
      "relations": []
    },
    {
      "name": "Material",
      "cnName": "材质",
      "layer": "concept",
      "keyProp": "name",
      "description": "器物材质概念，如：瓷、玉、铜、纸",
      "properties": [
        {"name": "name", "cnName": "名称", "dataType": "STRING", "required": true, "description": "材质名，全库唯一"}
      ],
      "relations": []
    },
    {
      "name": "Shape",
      "cnName": "器型",
      "layer": "concept",
      "keyProp": "name",
      "description": "器物形态概念，如：碗、瓶、炉、尊",
      "properties": [
        {"name": "name", "cnName": "名称", "dataType": "STRING", "required": true, "description": "器型名，全库唯一"}
      ],
      "relations": []
    },
    {
      "name": "Kiln",
      "cnName": "窑口",
      "layer": "concept",
      "keyProp": "name",
      "description": "瓷器烧造窑口概念，如：定窑、汝窑、景德镇窑",
      "properties": [
        {"name": "name", "cnName": "名称", "dataType": "STRING", "required": true, "description": "窑口名，全库唯一"}
      ],
      "relations": []
    },
    {
      "name": "Decoration",
      "cnName": "纹饰",
      "layer": "concept",
      "keyProp": "name",
      "description": "器物表面纹饰概念，如：莲纹、云龙纹",
      "properties": [
        {"name": "name", "cnName": "名称", "dataType": "STRING", "required": true, "description": "纹饰名，全库唯一"}
      ],
      "relations": []
    },
    {
      "name": "Site",
      "cnName": "出土地点",
      "layer": "concept",
      "keyProp": "name",
      "description": "藏品出土地点概念，如：北京元大都遗址",
      "properties": [
        {"name": "name", "cnName": "名称", "dataType": "STRING", "required": true, "description": "地点名，全库唯一"}
      ],
      "relations": []
    }
  ]
}
