# 构建产物
target/

# 项目内本地 Maven 仓库（.mvn/maven.config 指定，勿提交）
.m2/

# 本机 Maven 配置（指向项目内 .m2 仓库的绝对路径，各机自备，勿提交；
# 注意：只忽略此文件，.mvn/ 下的 maven-wrapper 是 mvnw 必需品需保持跟踪）
.mvn/maven.config
setting.xml
系统案例
docker/docker-compose.test.yml

# 运行时状态（graph-schema.json 首次启动从 classpath 模板自动生成）
data/

# 知识库上传文件与其 Markdown 转换件（用户上传的领域数据，版权敏感，不入库）
ontology-server/files/
ontology-server/files-md/

# 备份产物（运行时生成于 app.backup-dir）
backups/

# GeoLite2 定位数据库（get_location 工具；约 60MB 二进制且 CC BY 4.0，勿提交，README 提供获取渠道）
geolite2/

# 环境变量（含 API key，勿提交；模板见 .env.example）
.env

# 本地外部配置（Spring Boot 自动加载 ontology-server/config/，本地业务标题等，勿提交）
ontology-server/config/

# 临时测试文件
tmp/

# IDE
.idea/
*.iml
.vscode/
.settings/
.classpath
.project
*.launch

# 日志与崩溃转储
*.log
hs_err_pid*
replay_pid*

# 系统文件
Thumbs.db
.DS_Store
