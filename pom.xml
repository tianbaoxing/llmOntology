<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.conca</groupId>
    <artifactId>ontology-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>ontology-parent</name>
    <description>Neo4j graph service (query + batch import) for local ontology — 多模块聚合根</description>

    <modules>
        <!-- 内嵌 AgentScope Studio 对接源码（studio + tracing/telemetry） -->
        <module>ontology-agentscope-studio</module>
        <!-- 智能体定义/装配/导出包编解码（平台与导出工程共用，不依赖 Spring） -->
        <module>ontology-agent-runtime</module>
        <!-- Spring Boot 主应用 -->
        <module>ontology-server</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <neo4j-driver.version>5.14.0</neo4j-driver.version>
        <agentscope.version>2.0.3</agentscope.version>
        <!-- 知识库二进制文件（pdf/word/excel）自动转 Markdown -->
        <tika.version>2.9.2</tika.version>
        <flexmark.version>0.64.8</flexmark.version>
        <!-- 覆盖 Boot 3.2.5 管理的 opentelemetry 1.31.0：内嵌 studio 源码按 otel 1.61.0 编译，
             1.61 的 exporter 需要 sdk-common 1.61 的 StandardComponentId$ExporterType（1.31 无此类） -->
        <opentelemetry.version>1.61.0</opentelemetry.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 模块间依赖版本统一管理 -->
            <dependency>
                <groupId>com.conca</groupId>
                <artifactId>ontology-agentscope-studio</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.conca</groupId>
                <artifactId>ontology-agent-runtime</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
