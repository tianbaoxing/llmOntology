<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.conca</groupId>
        <artifactId>ontology-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>ontology-agentscope-studio</artifactId>
    <name>ontology-agentscope-studio</name>
    <description>AgentScope Studio 可视化对接（Run 注册 + 消息推送 + OTLP Trace 上报）内嵌源码模块，
        源码位于 io/agentscope/core/{studio,tracing}，原依赖 agentscope-extensions-studio 移除后的本地源码替代</description>

    <dependencies>
        <!-- AgentScope Java Harness 核心（AgentBase/Msg/Hook/Toolkit/Tracer 等被内嵌源码引用） -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-harness</artifactId>
            <version>${agentscope.version}</version>
        </dependency>
        <!-- Studio REST 上报（RegisterRun/PushMessage） -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp-jvm</artifactId>
            <version>5.3.2</version>
        </dependency>
        <!-- Studio WebSocket 实时通道（org.json 由其传递提供） -->
        <dependency>
            <groupId>io.socket</groupId>
            <artifactId>socket.io-client</artifactId>
            <version>2.1.2</version>
        </dependency>
        <!-- OTLP Trace 上报（版本经父 POM opentelemetry.version 属性覆盖为 1.61.0） -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry.instrumentation</groupId>
            <artifactId>opentelemetry-reactor-3.1</artifactId>
            <version>2.27.0-alpha</version>
        </dependency>
        <!-- pojo 序列化注解（版本随 Boot 管理） -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
        <!-- 响应式流（版本随 Boot 管理，agentscope-harness 亦传递提供） -->
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
    </dependencies>
</project>
